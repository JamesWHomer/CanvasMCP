# Copy this file to .env and fill in your values. .env is git-ignored.

# Your school's Canvas address (the one in your browser's address bar).
CANVAS_BASE_URL=https://yourschool.instructure.com

# Canvas → Account → Settings → "+ New Access Token"
CANVAS_API_TOKEN=

# Local server only: where download_files saves files (default: ~/Downloads/Canvas).
# CANVAS_DOWNLOAD_DIR=

# Set to true to enable submit_assignment, post_discussion_reply, send_message and planner edits.
CANVAS_ALLOW_WRITES=false

# Only for the remote (HTTP) server: the key clients must present. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_ACCESS_KEY=
